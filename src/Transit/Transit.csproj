<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Beerendonk.Transit</RootNamespace>
    <AssemblyName>Transit</AssemblyName>
    <Version>0.8.4-beta</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <Company>Beerendonk</Company>
    <Product>Transit</Product>
    <Description>Transit is a data format and a set of libraries for conveying values between applications written in different programming languages. This library provides support for marshalling Transit data to/from .NET.</Description>
    <Copyright>Beerendonk 2014</Copyright>
    <PackageId>Transit</PackageId>
    <PackageAuthors>Rick Beerendonk</PackageAuthors>
    <PackageTags>Transit</PackageTags>
    <PackageProjectUrl>https://github.com/rickbeerendonk/transit-csharp</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
